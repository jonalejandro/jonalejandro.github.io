---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}{% assign last_character = page.url | slice: -1, 1 %}{% if page.sitemap != false %}{% if last_character == '/' or page.url contains '.html' %}
<url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>
{% endif %}{% endif %}{% endfor %}
{% for post in site.posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc><lastmod>{{ post.date | date: '%Y-%m-%d' }}</lastmod></url>{% endfor %}
</urlset>
